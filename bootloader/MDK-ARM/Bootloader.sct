; STM32F103C8 Bootloader: 0x08000000-0x08005FFF (24 KiB)
; App starts at 0x08006000 and must not be included in this image.
LR_IROM1 0x08000000 0x00006000 {
  ER_IROM1 0x08000000 0x00006000 {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00005000 {
    .ANY (+RW +ZI)
  }
}
